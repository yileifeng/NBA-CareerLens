# To run database migration

python -m flask --app src.app db init
python -m flask --app src.app db migrate -m "commit message"
python -m flask --app src.app db upgrade

Terminal 1: 
docker compose up rabbitmq

Terminal 2: 
python -m src.messaging.consumer

Terminal 3: 
python -m flask --app src.app collect-season --season [YYYY-YY]
python -m flask --app src.app collect-seasons --start-season [YYYY-YY] --end-season [YYYY-YY]

python -m flask --app src.app run --debug
